{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "input-evidence-v1",
  "title": "AI Furniture Input Evidence v1",
  "type": "array",
  "items": {
    "$ref": "#/$defs/evidence"
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_path",
        "value",
        "source_type",
        "confidence",
        "state",
        "source_ref"
      ],
      "properties": {
        "target_path": {
          "type": "string",
          "minLength": 1
        },
        "value": {},
        "source_type": {
          "enum": [
            "USER_CONFIRMATION",
            "USER_DIMENSION",
            "USER_TEXT",
            "IMAGE_TEXT",
            "VISION_ENTITY",
            "DEFAULT_CANDIDATE"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "state": {
          "enum": [
            "ACTIVE",
            "SUPERSEDED",
            "CONFLICTED"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
